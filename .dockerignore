# Keep the build context small and avoid copying host-platform artifacts into
# the frontend-build stage - it runs its own `npm ci` from package-lock.json.
frontend/node_modules
frontend/dist

__pycache__
*.pyc
.venv
venv
*.egg-info
build
dist

# secrets & local state - never send these into an image build
.env
data
*.db

.git
.DS_Store
.idea
.vscode

# build artifact - regenerated by the frontend-build stage
airtag_sentry/web/static
