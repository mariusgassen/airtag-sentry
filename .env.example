# Copy to .env and fill in. This holds secrets/infra values; app behavior lives
# in config.yaml instead.

# --- Database ---
POSTGRES_USER=airtag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airtag_sentry
# Must match the values above when pointing at the bundled `postgres` service.
DATABASE_URL=postgresql://airtag:change-me@postgres:5432/airtag_sentry

# --- AirTag keys (alternative to airtags[].accessory_json_path in config.yaml) ---
# One var per airtag id that doesn't set accessory_json_path:
# AIRTAG_PRIVATE_KEY_B64_<ID>, where <ID> is that airtag's `id` from config.yaml,
# uppercased with non-alphanumeric characters replaced by `_`.
# Example for id: "bike":
# AIRTAG_PRIVATE_KEY_B64_BIKE=

# --- Dashboard login (GitHub OAuth; required) ---
# Create a GitHub OAuth App: https://github.com/settings/applications/new
# Authorization callback URL must be https://<your-domain>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only this GitHub username may log in to the dashboard.
GITHUB_ALLOWED_LOGIN=
# Random secret used to sign the session cookie, e.g. generate with `openssl rand -hex 32`.
SESSION_SECRET_KEY=

# --- Notifiers (each is optional; leave blank to disable) ---
NTFY_TOPIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web Push (generate with `python scripts/generate_vapid_keys.py`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Coolify ---
# Uncomment and Coolify will auto-provision a public domain + TLS for the
# dashboard service's port 8000. Leave commented for plain local docker compose.
# SERVICE_FQDN_DASHBOARD_8000=
