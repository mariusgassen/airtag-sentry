# Copy to .env and fill in. This holds secrets/infra values; app behavior lives
# in config.yaml instead.

# --- Database ---
POSTGRES_USER=airtag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airtag_sentry
# Must match the values above when pointing at the bundled `postgres` service.
DATABASE_URL=postgresql://airtag:change-me@postgres:5432/airtag_sentry

# --- AirTag key (alternative to airtag.accessory_json_path in config.yaml) ---
AIRTAG_PRIVATE_KEY_B64=

# --- Notifiers (each is optional; leave blank to disable) ---
NTFY_TOPIC_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web Push (generate with `python scripts/generate_vapid_keys.py`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Coolify ---
# Uncomment and Coolify will auto-provision a public domain + TLS for the
# dashboard service's port 8000. Leave commented for plain local docker compose.
# SERVICE_FQDN_DASHBOARD_8000=
