# Copy to .env and fill in. Every setting the app reads lives here - secrets,
# infra values, and app-behavior settings alike.

# --- Database ---
# DATABASE_URL is derived from these, not set directly - one source of truth
# instead of two values that have to be kept in sync.
POSTGRES_USER=airtag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airtag_sentry
# Optional overrides, only needed outside Docker Compose (defaults to
# localhost:5432; Compose itself always points dashboard at the
# `postgres` service regardless of these).
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- AirTag key encryption ---
# AirTag key material itself is entered through the dashboard's "AirTags
# verwalten" panel and stored encrypted in Postgres - not here. This is the
# master key used to encrypt/decrypt it at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRTAG_KEY_ENCRYPTION_KEY=

# --- Dashboard login (OIDC via your own identity provider; required) ---
# Register an OAuth2/OIDC application/provider for the dashboard (Authentik:
# Applications -> Applications, backed by an OAuth2/OIDC Provider). Redirect
# URI must be https://<your-domain>/auth/callback; grant type "Authorization
# code"; scopes must include openid, email and profile.
# OIDC_ISSUER is the provider's issuer URL - the app discovers the
# authorize/token/userinfo endpoints from
# <OIDC_ISSUER>/.well-known/openid-configuration, so it doesn't need those
# individually. In Authentik this is
# https://<authentik-host>/application/o/<application-slug>/.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only this email (from the ID token/userinfo response) may log in to the
# dashboard.
OIDC_ALLOWED_EMAIL=
# Random secret used to sign the session cookie, e.g. generate with `openssl rand -hex 32`.
SESSION_SECRET_KEY=

# --- Notifiers (each is optional; leave blank to disable) ---
# Telegram is not here - connect it from the dashboard's Settings ⚙️ ->
# Benachrichtigungen panel instead, same as Apple ID login. The bot token is
# encrypted and stored in Postgres, not this file.

# --- Web Push (generate with `python scripts/generate_vapid_keys.py`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- App behavior (all optional; defaults shown) ---
# Apple session persistence and anisette (Find My auth) settings. Not used
# under Docker Compose - it hardcodes ANISETTE_MODE/ANISETTE_REMOTE_URL to
# the bundled `anisette` container regardless of these. Apple ID login
# itself (AirTag tracking, and optional owner device tracking for "moved
# without you" alerts) happens from the dashboard's Settings panel, not
# here - see README "Getting started" / "Owner device tracking".
# APPLE_STORE_PATH=data/account.json
# APPLE_OWNER_SESSION_PATH=data/pyicloud_session
# ANISETTE_MODE=local              # local | remote
# ANISETTE_LIBS_PATH=data/ani_libs.bin
# ANISETTE_REMOTE_URL=             # e.g. http://anisette:6969, used when mode=remote

# Polling interval and movement-alert thresholds are NOT env vars - they're
# editable at runtime from the dashboard's Settings (⚙️) panel, stored in
# Postgres. See README "Movement detection" for what they mean.

# Dashboard bind address. Not used under Docker Compose - changing WEB_PORT
# there would need SERVICE_FQDN_DASHBOARD_8000 (below) updated to match.
# WEB_HOST=0.0.0.0
# WEB_PORT=8000

# --- Coolify ---
# Uncomment and Coolify will auto-provision a public domain + TLS for the
# dashboard service's port 8000. This is the only SERVICE_FQDN_* variable in
# the stack - the anisette/postgres services have no public exposure, so
# the whole deployment sits behind exactly one domain. Leave commented for
# plain local docker compose.
# SERVICE_FQDN_DASHBOARD_8000=
